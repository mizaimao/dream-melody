{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Dream Melody",
  "version": "0.1.0",
  "identifier": "io.github.mizaimao.dream-melody",
  "build": {
    "frontendDist": "../web"
  },
  "app": {
    "windows": [
      {
        "title": "Dream Melody",
        "width": 1100,
        "height": 780,
        "minWidth": 640,
        "minHeight": 480
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data:"
    },
    "withGlobalTauri": true
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg"
    ],
    "icon": [
      "icons/icon.png"
    ]
  }
}
